{
    "name": "GR00T_Bridge_EgoHOD_Embedding_Alignment",
    "n_gpu": 4,
    "model_type": "embedding",
    "use_checkpoint": false,
    "arch": {
        "type": "EmbeddingModel",
        "args": {
            "embeddings_path": "/mnt/bn/2d-videos/xy/work/mirror_neuron/data/embedding/bridge_egohod_proj_text_features.npz",
            "index_path": null,
            "task_meta_path": "/mnt/bn/2d-videos/xy/work/mirror_neuron/data/bridge_orig/bridge_orig_lerobot/meta/tasks_with_id.jsonl",
            "dataset_task_path": "/mnt/bn/2d-videos/xy/work/mirror_neuron/data/simplerenv_bridge/bridge_orig_lerobot/meta/tasks.jsonl",
            "normalize_embeddings": true,
            "preload_to_gpu": true
        }
    },
    "alignment": {
        "use_alignment": true,
        "model_type": "AlignmentModel",
        "args": {
            "egovlpv2_dim": 512,
            "openvla_dim": 1536,
            "projection_dim": 512,
            "token_egovlpv2_dim": 512,
            "temperature": 0.1,
            "dropout": 0.1,
            "layer_norm_eps": 1e-5,
            "layer_indices": [10],
            "text_proj_config": {
                "use_fc_projection": true,
                "proj_num_layers": 1,
                "proj_hidden_dim": 1024
            },
            "action_proj_config": {
                "use_fc_projection": false,
                "proj_num_layers": 2,
                "proj_hidden_dim": 1024
            },
            "use_feature_bank": false,
            "feature_bank_size": 512,
            "alignment_mode": "task_id",
            "vla_mode": "gr00t",
            "min_valid_ratio": 0.0,
            "use_distributed_negatives": false,
            "loss_type": "sigmoid",
            "sigmoid_bias": 1.5,
            "learnable_temperature": false,
            "learnbale_bias": false,
            "action_pool_mode": "learnable_query",
            "action_pool_config": {
                "num_layers": 1,
                "mlp_hidden_dim": 1024
            },
            "use_disentangle": false,
            "disentangle_config": {
                "position": "pre_pool",
                "encoder_type": "mlp",
                "hidden_dim": 512,
                "diff_mode": "cosine",
                "diff_weight": 0.075,
                "recon_weight": 0.01,
                "dropout": 0.1
            },
            "mode_config": {
                "as2ts": {
                    "enabled": true,
                    "weight": 1.0
                },
                "as2tt": {
                    "enabled": false,
                    "weight": 0.0,
                    "temperature": 0.05
                },
                "at2tt": {
                    "enabled": false,
                    "weight": 0.0
                },
                "at2tt_soft": {
                    "enabled": false,
                    "weight": 0.0,
                    "attn_temperature": 0.01
                }
            }
        },
        "optimizer": {
            "type": "AdamW",
            "args": {
                "lr": 0.0001,
                "weight_decay": 0.01
            }
        },
        "training": {
            "enabled": true,
            "log_interval": 10,
            "save_interval": 1000,
            "backbone_update_start_pct": 0.1,
            "stop_last_pct": 0.0
        }
    }
}
