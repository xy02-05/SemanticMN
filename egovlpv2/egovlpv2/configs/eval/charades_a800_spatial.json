{
    "name": "CharadesEgo",
    "n_gpu": 1,
    "arch": {
        "type": "FrozenInTime",
        "args": {
            "video_params": {
                "model": "SpaceTimeTransformer",
                "arch_config": "base_patch16_224",
                "num_frames": 4,
                "pretrained": true,
                "time_init": "zeros",
		"drop_path_rate": 0.0
            },
            "text_params": {
                "model": "roberta-base",
                "pretrained": true,
                "input": "text"
            },
            "projection": "minimal",
            "load_checkpoint": "/data/xuyuan/UniVLA_env/mirror_neuron/vlas/SpatialVLA/outputs/spatialvla_4b_mimic_align/2025-08-19/04-11-02_bridge_orig_spatialvla-4b-224-pt_mimic_align_lr5e-4_bs16_node1_gpu1/checkpoint-6200/egovlpv2_model.pth"
	}
    },
    "alignment": {
        "use_alignment": true,
        "model_type": "AlignmentModel",
        "args": {
            "egovlpv2_dim": 256,
            "openvla_dim": 2304,
            "projection_dim": 512,
            "temperature": 0.07,
            "cross_attention_layers": 2,
            "num_heads": 4,
            "dropout": 0.1,
            "use_projection_head": true,
            "layer_norm_eps": 1e-5,
            "layer_indices": [26]
        },
        "loss_weight": 1.0,
        "optimizer": {
            "type": "AdamW",
            "args": {
                "lr": 0.0001,
                "weight_decay": 0.01
            }
        },
        "training": {
            "enabled": true,
            "log_interval": 10,
            "save_interval": 100
        }
    },
    "data_loader":
    	    [
            {
                "type": "MultiDistTextVideoDataLoader",
                "args":{
                    "dataset_name": "CharadesEgo",
                    "data_dir": "/data/xuyuan/UniVLA_env/mirror_neuron/egovlpv2/data/CharadesEgo/CharadesEgo_v1_480_resize256",
                    "meta_dir": "/data/xuyuan/UniVLA_env/mirror_neuron/egovlpv2/data/CharadesEgo/CharadesEgo",
                    "reader": "cv2_charades",
                    "shuffle": true,
                    "num_workers": 4,
                    "batch_size": 16,
                    "split": "train",
                    "text_params": {
                        "input": "text"
                    },
                    "video_params": {
                        "input_res": 224,
                        "num_frames": 4,
                        "loading": "lax"
                    }
                }
            }
	    ],
    "optimizer": {
        "type": "AdamW",
        "args":{
            "lr": 0.00015,
	    "weight_decay": 0.01,
	    "lr_mult_head": 1,
	    "lr_mult_cross_modal": 1
        }
    },
    "loss": {
        "type": "NormSoftmaxLoss",
        "args": {
        }
    },
    "metrics": [
        "charades_metrics_vtc"
     ],
    "trainer": {
        "epochs": 0,
        "max_samples_per_epoch": 500000,
        "save_dir": "",
        "save_period": 2,
        "verbosity": 2,
        "monitor": "min val_loss_0",
        "early_stop": 10,
        "init_val": true,
        "neptune": false
    },
    "visualizer": {
        "type": ""
    }
} 